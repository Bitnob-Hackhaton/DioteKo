# DioteKo root INFRA env — DEV. Copy to `.env.dev`.
#
# Consumed by `docker compose --env-file .env.dev` (wired in by the npm scripts:
# dev:up / db:setup / db:reset). Holds only values the compose files
# interpolate — NOT the backend-nest app config, which lives in
# backend-nest/.env (+ .env.test / .env.prod).
#
# Every var also has a `${VAR:-default}` fallback in the compose files, so a
# missing `.env.dev` still works with these exact values.

# --- DioteKo's own Postgres (container `dioteko-postgres-bitnob`, own project network) ---
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password
# Host port published for tools run on your machine (migrations, psql, GUI). Pick
# another free port if 5442 is taken, then set the same value as DB_PORT (and in
# DATABASE_URL) in backend-nest/.env and backend-nest/.env.test.
DIOTEKO_PG_HOST_PORT=5442
# (DioteKo's database names — dioteko_dev_bitnob / dioteko_test_bitnob — are fixed literals in
# the compose files and the E2E guards; not configurable here.)

# --- Appwrite (local, self-hosted; dev only) ---
APPWRITE_HTTP_PORT=9000
# Generate BOTH with `openssl rand -hex 32`. _APP_OPENSSL_KEY_V1 encrypts data
# at rest — NEVER change it after the first boot or existing data is unreadable.
APPWRITE_KEY=dev-only-change-me-min-32-characters-long
APPWRITE_OPENSSL_KEY_V1=dev-only-change-me-min-32-characters-long
APPWRITE_DB_PASS=appwrite
APPWRITE_DB_ROOT_PASS=appwrite_root

# --- HTTPS tunnels (`npm run tunnel`; ngrok containers, dev only) ---
# Google OAuth and the phone need HTTPS URLs. A free ngrok account allows ONE agent session
# and ONE static domain, so each tunnel gets its own account: authtoken from
# dashboard.ngrok.com > Your Authtoken, domain from Universe > Domains (xxxx.ngrok-free.dev).
# Keep the real tokens in .env.dev only (gitignored) — never in this example file.
# Appwrite tunnel (-> appwrite:80, used for Google login from the phone).
NGROK_APPWRITE_AUTHTOKEN=
NGROK_APPWRITE_DOMAIN=
# backend-nest tunnel (-> backend-nest:3003): Bitnob webhooks, phone -> API over HTTPS.
NGROK_BACKEND_AUTHTOKEN=
NGROK_BACKEND_DOMAIN=

# --- Idswyft (self-hosted KYC; dev only) --- see docker-compose.idswyft.yml and docs/KYC.md
# Release tag of github.com/team-idswyft/idswyft-community the images are built from.
IDSWYFT_VERSION=v1.12.19
# Host ports: API http://localhost:8010 (docs at /api/docs), dashboard http://localhost:8087.
IDSWYFT_API_HOST_PORT=8010
IDSWYFT_DASHBOARD_HOST_PORT=8087
# Idswyft's own Postgres (never DioteKo's). Dev defaults; change them for anything shared.
IDSWYFT_DB_USER=idswyft
IDSWYFT_DB_PASSWORD=idswyft_dev_password
# Generate with `openssl rand -hex 32`.
IDSWYFT_JWT_SECRET=dev-only-change-me-min-32-characters-long
# Dev placeholders (>= 32 chars). IDSWYFT_API_KEY_SECRET hashes every API key: never change it once keys exist.
IDSWYFT_API_KEY_SECRET=dev-only-api-key-secret-min-32-characters
IDSWYFT_ENCRYPTION_KEY=dev-only-encryption-key-min-32-characters-long
IDSWYFT_SERVICE_TOKEN=dev-only-service-token-min-32-characters-long

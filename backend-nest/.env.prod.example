# DioteKo backend-nest environment variables — PRODUCTION template.
# Copy to `.env.prod` on the deploy host. Selected when NODE_ENV=production
# (src/config/env-files.ts). NOT used in local dev — `dioteko_prod` is not
# created by the local tooling.
#
# Every secret below MUST be a strong, unique, deploy-only value. Leave blank
# in version control.

NODE_ENV=production
PORT=3001
# MUST be set and HTTPS in production — BitnobPayoutsService rejects a
# non-HTTPS callback URL when BITNOB_ENVIRONMENT=production. Left blank so a
# forgotten value fails the boot check instead of shipping a bogus origin.
APP_BASE_URL=

# --- PostgreSQL (TypeORM) ---
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=dioteko_prod
DATABASE_URL=

# --- JWT / VC signing (generate with `openssl rand -hex 32`) ---
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
VC_ISSUER=dioteko
VC_SIGNING_SECRET=
CERTIFICATE_VALIDITY_DAYS=365

# --- Bitnob ---
# NOTE: BITNOB_ENVIRONMENT=production currently DISABLES every money-move method
# (hard ForbiddenException — see docs/DECISIONS.md, Bitnob production gate).
BITNOB_CLIENT_ID=
BITNOB_CLIENT_SECRET=
BITNOB_WEBHOOK_SECRET=
BITNOB_BASE_URL=https://api.bitnob.com
BITNOB_ENVIRONMENT=production
BITNOB_PAYOUT_BENEFICIARY_ACCOUNT_NUMBER=
BITNOB_PAYOUT_BENEFICIARY_ACCOUNT_NAME=
BITNOB_PAYOUT_BENEFICIARY_BANK_CODE=
BITNOB_PAYOUT_BENEFICIARY_COUNTRY=

# PAYMENT_SIMULATION must stay ABSENT here: it lets any holder get a certificate without paying (boot is refused
# in production anyway).

# --- Appwrite ---
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_TEST_USER_EMAIL=
APPWRITE_TEST_USER_PASSWORD=
# Must stay true: production always requires a Google identity (a false value
# here is ignored and logged as a warning at boot).
APPWRITE_REQUIRE_GOOGLE_IDENTITY=true
# KYC (Idswyft). Production always enforces the identity check (KYC_ENFORCEMENT=off is ignored).
IDSWYFT_BASE_URL=
IDSWYFT_API_KEY=
IDSWYFT_WEBHOOK_SECRET=
KYC_ENFORCEMENT=on
KYC_ENFORCED_TYPES=
# Manual review: the KYC_MRZ_PRECHECK / KYC_PROVIDER_MODE relaxations are ignored in production. The fallback is allowed
# (it is then a real review process) and needs the encryption key below (`openssl rand -hex 32`).
KYC_FALLBACK_MANUAL_REVIEW=off
KYC_DOC_ENCRYPTION_KEY=
KYC_DOC_RETENTION_DAYS=30

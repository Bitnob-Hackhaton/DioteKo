# DioteKo backend-nest environment variables — TEST template (E2E suite).
# Copy to `.env.test`. Selected automatically when NODE_ENV=test
# (src/config/env-files.ts) — `npm run test:e2e` sets that via cross-env.
#
# Targets the `dioteko_test_bitnob` database on the SAME DioteKo Postgres instance as
# dev (host port 5442) — never `dioteko_dev_bitnob` (data pollution) and never `dioteko_prod`.

NODE_ENV=test
PORT=3003
# Required at boot. Kept HTTP for tests (Bitnob prod HTTPS check only fires
# when BITNOB_ENVIRONMENT=production, which tests never use).
APP_BASE_URL=http://localhost:3003

# --- PostgreSQL (TypeORM) ---
DB_HOST=localhost
DB_PORT=5442
DB_USERNAME=postgres_user
DB_PASSWORD=postgres_password
DB_NAME=dioteko_test_bitnob
DATABASE_URL=postgresql://postgres_user:postgres_password@localhost:5442/dioteko_test_bitnob

# --- JWT / VC signing ---
# Both are @IsNotEmpty() at boot. Use throwaway TEST-ONLY literals — never the
# dev or prod values. Tokens signed here are only ever verified within the
# E2E process.
JWT_SECRET=e2e-test-only-jwt-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
VC_ISSUER=dioteko-backend-nest-test
VC_SIGNING_SECRET=e2e-test-only-vc-signing-secret
CERTIFICATE_VALIDITY_DAYS=365

# --- Bitnob ---
# Leave credentials blank. BITNOB_ENVIRONMENT MUST stay `sandbox` for any
# money-move E2E (the production gate throws a ForbiddenException first thing).
# A Bitnob webhook E2E either sets a known BITNOB_WEBHOOK_SECRET and computes
# the HMAC-SHA512 itself, or asserts the persist-only / not-dispatched path.
BITNOB_CLIENT_ID=
BITNOB_CLIENT_SECRET=
BITNOB_WEBHOOK_SECRET=
BITNOB_BASE_URL=
BITNOB_ENVIRONMENT=sandbox
BITNOB_PAYOUT_BENEFICIARY_ACCOUNT_NUMBER=
BITNOB_PAYOUT_BENEFICIARY_ACCOUNT_NAME=
BITNOB_PAYOUT_BENEFICIARY_BANK_CODE=
BITNOB_PAYOUT_BENEFICIARY_COUNTRY=

# --- Appwrite ---
# appwrite-login.e2e-spec.ts is skipped unless APPWRITE_API_KEY is set. To run
# it, point at the local dev Appwrite (host port 9000), fill in the project id
# + API key, and `npm run seed:appwrite` to create the test user.
APPWRITE_ENDPOINT=http://localhost:9000/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_TEST_USER_EMAIL=appwrite-e2e@dioteko.local
APPWRITE_TEST_USER_PASSWORD=
# The E2E seed user signs in with email+password (no Google identity), so the
# Google-identity gate must be relaxed here. Ignored (forced true) in production.
APPWRITE_REQUIRE_GOOGLE_IDENTITY=false
# KYC_ENFORCEMENT stays at its default (on): test/kyc.e2e-spec.ts expects residence requests to be refused without KYC.
# The E2E never reaches Idswyft, so no instance is needed.
IDSWYFT_API_KEY=
IDSWYFT_WEBHOOK_SECRET=

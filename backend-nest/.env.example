# DioteKo backend-nest environment variables — DEV template.
# Copy to `.env` and fill in real values. Leave secrets blank in version control.
#
# NODE_ENV selects the file at boot (see src/config/env-files.ts):
#   development / unset -> .env        (this template)      DB: dioteko_dev_bitnob
#   test                -> .env.test   (.env.test.example)  DB: dioteko_test_bitnob
#   production          -> .env.prod   (.env.prod.example)  DB: dioteko_prod

NODE_ENV=development
PORT=3003
# Public origin of this API — required at boot. Used to build the Bitnob
# payout callback_url (${APP_BASE_URL}/api/bitnob/webhooks). Must be
# HTTPS only when BITNOB_ENVIRONMENT=production.
APP_BASE_URL=http://localhost:3003

# --- PostgreSQL (TypeORM) ---
# DioteKo's own Postgres (container `dioteko-postgres-bitnob`; run `npm run dev:up` at
# the repo ROOT first). It publishes host port 5442, set by DIOTEKO_PG_HOST_PORT
# in the root .env.dev: keep DB_PORT and DATABASE_URL below in sync with it.
DB_HOST=localhost
DB_PORT=5442
DB_USERNAME=postgres_user
DB_PASSWORD=postgres_password
DB_NAME=dioteko_dev_bitnob
# Composed connection string, informational only — the app reads the discrete
# DB_* vars above; DATABASE_URL is provided for convenience with external
# tools (psql, GUI clients) and must be kept in sync with them manually.
DATABASE_URL=postgresql://postgres_user:postgres_password@localhost:5442/dioteko_dev_bitnob

# --- JWT (app-issued access/refresh tokens) ---
# Required — app refuses to boot without this (see config/env.validation.ts).
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Verifiable Credential signing (generalized from old CERTIFICATE_VC_*) ---
VC_ISSUER=dioteko-backend-nest
# Required — app refuses to boot without this (see config/env.validation.ts).
# A missing/blank secret would let anyone forge a validly-signed VC.
VC_SIGNING_SECRET=
CERTIFICATE_VALIDITY_DAYS=365

# --- Bitnob (user fills in later once credentials exist) ---
BITNOB_CLIENT_ID=
BITNOB_CLIENT_SECRET=
# Secret Bitnob signs inbound webhook payloads with — HMAC-SHA512 over the raw
# request body, sent in the x-bitnob-signature header (hex, no prefix). This is
# a DIFFERENT construction from the outbound request-signing secret above.
# When unset, the webhook guard falls back to BITNOB_CLIENT_SECRET; confirm in
# the Bitnob dashboard which secret webhooks actually use. Unset + non-prod =>
# signature verification is skipped (dev only). Unset + production => the guard
# rejects every delivery (fail closed).
BITNOB_WEBHOOK_SECRET=
BITNOB_BASE_URL=
# sandbox | production (default sandbox). production disables payout finalize
# (Increment 3 interim state) and forces an HTTPS callback URL.
BITNOB_ENVIRONMENT=sandbox
# Server-side bank beneficiary for certificate-scoped payouts. The certificate
# payout API carries NO beneficiary — it is resolved from these four vars.
# All four must be set or a certificate payout fails with a 500.
BITNOB_PAYOUT_BENEFICIARY_ACCOUNT_NUMBER=
BITNOB_PAYOUT_BENEFICIARY_ACCOUNT_NAME=
BITNOB_PAYOUT_BENEFICIARY_BANK_CODE=
BITNOB_PAYOUT_BENEFICIARY_COUNTRY=

# Background reconciler for pending Bitnob invoices (reads each from Bitnob, applies paid/expired).
# Period in ms, default 60000; 0 disables; max 86400000 (rejected at boot above). A positive value below 5000
# is raised to 5000 (warn at startup). Always off when NODE_ENV=test.
# One backend instance is recommended: every instance runs its own reconciler (harmless, markPaid/markClosed are
# conditional, but Bitnob reads are duplicated). Set 0 on secondary instances.
BITNOB_INVOICE_RECONCILE_INTERVAL_MS=60000
# DEV ONLY - payment simulation: adds POST /api/admin-certificates/dev/requests/:id/mark-paid, which lets the
# request holder mark their own invoice paid so the certificate is generated without any real payment (nothing
# can be paid in the Bitnob sandbox). The server refuses to boot unless NODE_ENV=development|test AND
# BITNOB_ENVIRONMENT=sandbox is set explicitly. Leave it unset/false to use the real Bitnob path.
# Certificates obtained this way carry simulatedPayment=true in the signed credential.
# PAYMENT_SIMULATION=true
# Automatic issuance for types that need no review (birth, marriage, death). Default: ON when not live, OFF when live
# (NODE_ENV=production OR BITNOB_ENVIRONMENT=production): requests then wait for an agent unless this is exactly true. Auto-issued certificates carry
# declaredNotVerified=true in the signed credential and a "declared, not verified" line in the PDF.
# CERT_AUTO_ISSUE=true
# Web console (frontweb) browser origins allowed by CORS: comma-separated EXACT origins, no wildcard, no path.
# Default: http://localhost:3000 outside production, none in production. The mobile app is not subject to CORS.
# CORS_ORIGINS=http://localhost:3000
# Period (ms) of the pass that resumes paid-but-not-generated requests (default 60000, 0 = off, floor 5000).
# ADMIN_CERTIFICATES_RESUME_INTERVAL_MS=60000

# --- Appwrite / Google OAuth (mobile client login) ---
# `npm run dev:up` runs a local Appwrite at host port 9000. Do the one-time
# console setup (docs/DEV_WORKFLOW.md "Appwrite first-run"), then fill in the
# project id + API key. The backend-nest container overrides APPWRITE_ENDPOINT
# to http://appwrite/v1 via docker-compose.dev.yml; this value is for host
# tools and the mobile app.
APPWRITE_ENDPOINT=http://localhost:9000/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
# `npm run seed:appwrite` ensures this email/password user exists (idempotent).
APPWRITE_TEST_USER_EMAIL=appwrite-e2e@dioteko.local
APPWRITE_TEST_USER_PASSWORD=
# Fail-closed gate for POST /auth/appwrite/login: when true (default if unset,
# and ALWAYS true when NODE_ENV=production) the Appwrite account must carry a
# Google identity. Set false only for local dev with an email+password seed user.
APPWRITE_REQUIRE_GOOGLE_IDENTITY=true

# --- KYC (Idswyft, self-hosted: docker-compose.idswyft.yml at the repo root, started by `npm run dev:up`) ---
# Nest on the host: the published API port. The backend container ignores this value
# (docker-compose.dev.yml sets IDSWYFT_BASE_URL=http://idswyft-api:3001).
IDSWYFT_BASE_URL=http://localhost:8010
# API key created from the Idswyft dashboard (http://localhost:8087, see docs/KYC.md). Never commit a real value.
IDSWYFT_API_KEY=
# Secret shared with the webhook registered in Idswyft (HMAC-SHA256 on X-Idswyft-Signature).
IDSWYFT_WEBHOOK_SECRET=
# Idswyft ML engine, for the pre-upload photo check (is there a document / a face in the picture?). Empty = no check.
# The backend container gets http://idswyft-ml-engine:3002 from docker-compose.dev.yml.
IDSWYFT_ENGINE_URL=
# Identity check on certificate requests. `off` is dev only and ignored in production.
KYC_ENFORCEMENT=on
# Types whose policy is `planned` (birth, marriage, death) but enforced anyway, comma-separated.
KYC_ENFORCED_TYPES=
# New verification sessions per holder per 24 h (1-50, default 5).
KYC_MAX_SESSIONS_PER_DAY=5
# --- KYC manual review by an agent (docs/PLAN_KYC_MANUAL_REVIEW.md) ---
# MRZ photo check: strict (refuse an unreadable MRZ) | warn (the holder may send it anyway) | off. Forced to strict in production.
KYC_MRZ_PRECHECK=strict
# on: a provider rejection or outage sends the dossier to an agent (console > Verifications d'identite) instead of failing it.
KYC_FALLBACK_MANUAL_REVIEW=off
# manual_only: Idswyft is not called, an agent decides every dossier (dev / demo). Forced to idswyft in production.
KYC_PROVIDER_MODE=idswyft
# AES-256 key (64 hex chars, `openssl rand -hex 32`) encrypting the document copies agents review. Empty = no copy kept.
KYC_DOC_ENCRYPTION_KEY=
# Days an undecided copy is kept (1-365, default 30). Copies are deleted at the decision.
KYC_DOC_RETENTION_DAYS=30

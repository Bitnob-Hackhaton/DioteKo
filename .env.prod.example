# DioteKo root env — PRODUCTION compose interpolation. Copy to `.env.prod` on
# the deploy host: `docker compose -f docker-compose.prod.yml --env-file .env.prod up`.
#
# This file ONLY feeds the ${...} vars in docker-compose.prod.yml — i.e. the
# LEGACY Express `backend` service. The NestJS `backend-nest` service reads its
# full config from `backend-nest/.env.prod` (copy backend-nest/.env.prod.example).


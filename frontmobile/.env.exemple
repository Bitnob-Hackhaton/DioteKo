# Optionnel. Laisser vide : l'app derive l'IP LAN de l'hote Expo (telephone physique).
# Ne PAS mettre localhost sur un telephone (= le telephone lui-meme) ; localhost ne vaut que pour emulateur iOS / navigateur.
# EXPO_PUBLIC_API_BASE_URL=http://<IP-LAN-du-PC>:3003/api
# URL HTTPS du tunnel vers l'Appwrite de la stack (port 9000) : `npm run tunnel` a la racine
# l'affiche (NGROK_APPWRITE_DOMAIN dans .env.dev). Puis `npx expo start --clear`.
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://YourAppwriteEndpoint/v1
EXPO_PUBLIC_APPWRITE_PROJECT_ID=YourAppwriteProjectId